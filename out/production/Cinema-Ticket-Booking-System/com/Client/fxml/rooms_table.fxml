<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="roomsT" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.Client.controllers.RoomsTableController">
    <left>
        <VBox fx:id="sideMenu" prefWidth="300.0" spacing="20.0" style="-fx-background-color: #3a4f63;">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Button fx:id="doctorsSideButton" mnemonicParsing="false" onAction="#handleDoctorsSideButton" prefWidth="250.0" style="-fx-font-size: 16px;" text="Doctors" />
                <Button fx:id="patientsSideButton" mnemonicParsing="false" onAction="#handlePatientsSideButton" prefWidth="250.0" style="-fx-font-size: 16px;" text="Patients" />
                <Button fx:id="appointmentsSideButton" mnemonicParsing="false" onAction="#handleAppointmentsSideButton" prefWidth="250.0" style="-fx-font-size: 16px;" text="Appointments" />
                <Button fx:id="backSideButton" mnemonicParsing="false" onAction="#handleBackSideButton" prefWidth="250.0" style="-fx-font-size: 16px;" text="Back" />
                <Button fx:id="logoutSideButton" mnemonicParsing="false" onAction="#handleLogoutSideButton" prefWidth="250.0" style="-fx-font-size: 16px;" text="Logout" />
            </children>
        </VBox>
    </left>
    <center>
        <VBox fx:id="tableContent" alignment="TOP_CENTER" spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label fx:id="roomsLabel" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Rooms Table (Occupied)" />
                <TableView fx:id="roomsTable" fixedCellSize="50.0" prefHeight="800.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="roomNumCol" prefWidth="100.0" text="Room #" />
                        <TableColumn fx:id="roomIdCol" prefWidth="80.0" text="Patient ID" />
                        <TableColumn fx:id="roomNameCol" prefWidth="400.0" text="Patient Name" />
                        <TableColumn fx:id="roomSymptomsCol" prefWidth="400.0" text="Symptoms" />
                        <TableColumn fx:id="roomEmergencyCol" prefWidth="300.0" text="Emergency Case" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <HBox fx:id="buttonBar" alignment="CENTER" spacing="42.0">
                    <children>
                        <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBackButton" prefHeight="80.0" prefWidth="210.0" style="-fx-font-size: 16px;" text="Back" />
                        <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSaveButton" prefHeight="80.0" prefWidth="210.0" style="-fx-font-size: 16px;" text="Save" /> <Button fx:id="vacateButton" mnemonicParsing="false" onAction="#handleVacateButton" prefHeight="80.0" prefWidth="210.0" style="-fx-font-size: 16px;" text="Vacate Room" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>