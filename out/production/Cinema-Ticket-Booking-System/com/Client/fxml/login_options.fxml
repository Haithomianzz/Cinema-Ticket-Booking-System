<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="loginOPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.Client.controllers.LoginOptionsController">
    <children>
        <ImageView fx:id="backgroundImageView" fitHeight="1080.0" fitWidth="1920.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../resources/background.jpg" />
            </image>
        </ImageView>
        <VBox fx:id="frame" alignment="CENTER" maxHeight="450.0" maxWidth="750.0" spacing="50.0" style="-fx-background-color: rgba(200, 200, 200, 0.8); -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: black; -fx-border-width: 2;">
            <children>
                <Button fx:id="adminLoginButton" minHeight="50.0" minWidth="200.0" mnemonicParsing="false" onAction="#handleAdminLogin" style="-fx-font-size: 18px; -fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;" text="Admin Login" />
                <Button fx:id="physicianLoginButton" minHeight="50.0" minWidth="200.0" mnemonicParsing="false" onAction="#handlePhysicianLogin" style="-fx-font-size: 18px; -fx-background-color: #28a745; -fx-text-fill: white; -fx-background-radius: 5;" text="Physician Login" />
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
        <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBackButtonAction" style="-fx-font-size: 16px; -fx-background-color: #6c757d; -fx-text-fill: white; -fx-background-radius: 5;" text="Back" StackPane.alignment="BOTTOM_LEFT">
            <StackPane.margin>
                <Insets bottom="20.0" left="20.0" />
            </StackPane.margin>
        </Button>
    </children>
</StackPane>