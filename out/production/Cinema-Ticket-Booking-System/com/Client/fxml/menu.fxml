<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="menuPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.Client.controllers.MenuController">
    <children>
        <ImageView fx:id="backgroundImageView" fitHeight="1080.0" fitWidth="1920.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../resources/background.jpg" />
            </image>
        </ImageView>
        <VBox fx:id="frame" alignment="CENTER" maxHeight="450.0" maxWidth="750.0" spacing="50.0" style="-fx-background-color: rgba(200, 200, 200, 0.8); -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: black; -fx-border-width: 2;">
            <children>
                <Label fx:id="titleLabel" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Welcome to the Cinema Ticket Booking System" />
                <Button fx:id="loginButton" minHeight="50.0" minWidth="200.0" mnemonicParsing="false" onAction="#handleLoginButtonAction" style="-fx-font-size: 18px; -fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;" text="Login" />
                <Button fx:id="exitButton" minHeight="50.0" minWidth="200.0" mnemonicParsing="false" onAction="#handleExitButtonAction" style="-fx-font-size: 18px; -fx-background-color: #dc3545; -fx-text-fill: white; -fx-background-radius: 5;" text="Exit" />
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </children>
</StackPane>