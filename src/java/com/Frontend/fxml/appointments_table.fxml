<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="appointmentsT" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.Frontend.controllers.AppointmentsTableController">
    <left>
        <VBox fx:id="sideMenu" prefWidth="300.0" spacing="20.0" style="-fx-background-color: #3a4f63;">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Button fx:id="doctorsSideButton" mnemonicParsing="false" onAction="#handleDoctorsSideButton" prefWidth="250.0" style="-fx-font-size: 16px;" text="Doctors" />
                <Button fx:id="patientsSideButton" mnemonicParsing="false" onAction="#handlePatientsSideButton" prefWidth="250.0" style="-fx-font-size: 16px;" text="Patients" />
                <Button fx:id="roomsSideButton" mnemonicParsing="false" onAction="#handleRoomsSideButton" prefWidth="250.0" style="-fx-font-size: 16px;" text="Rooms" />
                <Button fx:id="backSideButton" mnemonicParsing="false" onAction="#handleBackSideButton" prefWidth="250.0" style="-fx-font-size: 16px;" text="Back" />
                <Button fx:id="logoutSideButton" mnemonicParsing="false" onAction="#handleLogoutSideButton" prefWidth="250.0" style="-fx-font-size: 16px;" text="Logout" />
            </children>
        </VBox>
    </left>
    <center>
        <VBox fx:id="tableContent" alignment="TOP_CENTER" spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label fx:id="AptLabel" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Appointments Table" />
                <TableView fx:id="appointmentsTable" fixedCellSize="50.0" prefHeight="800.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="apptIdCol" prefWidth="300.0" text="Appointment #" />
                        <TableColumn fx:id="apptPatientIdCol" prefWidth="300.0" text="Patient #" />
                        <TableColumn fx:id="apptDoctorIdCol" prefWidth="300.0" text="Doctor #" />
                        <TableColumn fx:id="apptDateCol" prefWidth="300.0" text="Date" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <HBox fx:id="buttonBar" alignment="CENTER" spacing="42.0">
                    <children>
                        <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBackButton" prefHeight="80.0" prefWidth="210.0" style="-fx-font-size: 16px;" text="Back" />
                        <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSaveButton" prefHeight="80.0" prefWidth="210.0" style="-fx-font-size: 16px;" text="Save" />
                        <Button fx:id="editButton" mnemonicParsing="false" onAction="#handleEditButton" prefHeight="80.0" prefWidth="210.0" style="-fx-font-size: 16px;" text="Edit" />
                        <Button fx:id="addButton" mnemonicParsing="false" onAction="#handleAddButton" prefHeight="80.0" prefWidth="210.0" style="-fx-font-size: 16px;" text="Add" />
                        <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#handleDeleteButton" prefHeight="80.0" prefWidth="210.0" style="-fx-font-size: 16px;" text="Delete" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>